TG_API_ID=xxx
TG_API_HASH=xxx
TG_PHONE=+xxxx
TG_SESSION_NAME=xxxxxxxxxxxxxx
# Numeric chat id (see get_chat_id.py) or @username of the single signal channel
#TG_CHANNEL=xxxx
TG_CHANNEL=xxxx

# LLM_PROVIDER=openai (default) or ollama (OpenAI-compatible API on local Ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=xxx
OPENAI_MODEL=xxxx
# Optional: override API base URL (Ollama default when LLM_PROVIDER=ollama: http://localhost:11434/v1)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_PROXY=
CLASSIFIER_CONTEXT_SIZE=10

UPSTOX_API_KEY=xx
UPSTOX_API_SECRET=xx
UPSTOX_ACCESS_TOKEN=xx.xx.xxx-xx

DATABASE_URL=sqlite+aiosqlite:///data/tal.db
# Pipeline heartbeat file read by the dashboard
STATUS_FILE=data/status.json
UI_HOST=127.0.0.1
UI_PORT=8000

BROKER=upstox
LOTS=1
# Verify current exchange lot sizes before use
LOT_SIZE_MAP={"NIFTY":65,"BANKNIFTY":30, "SENSEX":20}
RR_REWARD=2
RR_RISK=1
EXIT_MODE=RR
ASSEMBLY_WINDOW_MIN=30
ENTRY_TIMEOUT_MIN=60
MARKET_CLOSE_EXIT=15:15
SLIPPAGE=0
BROKERAGE_PER_ORDER=0